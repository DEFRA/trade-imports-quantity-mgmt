<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>Defra.Trade.Imports.Quantity.Management.Client</PackageId>
    <VersionPrefix>0.1.0</VersionPrefix>
    <PackageDescription>Defra Trade Imports Quantity Management Client</PackageDescription>
    <Company>DEFRA</Company>
    <RepositoryUrl>https://github.com/DEFRA/trade-imports-quantity-mgmt</RepositoryUrl>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Refit.HttpClientFactory" Version="11.0.1" />
    <PackageReference Include="AWSSDK.SecurityToken" Version="4.0.7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TradeImportsQuantityMgmt.Contract\TradeImportsQuantityMgmt.Contract.csproj" />
  </ItemGroup>
</Project>
